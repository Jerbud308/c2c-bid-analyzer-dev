# ============================================================================
# C2C Restoration Government Bid Analyzer - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control
# ============================================================================

# ----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ----------------------------------------------------------------------------
# Get these values from your Supabase project dashboard:
# https://app.supabase.com/project/{your-project-id}/settings/api
# ----------------------------------------------------------------------------

# Supabase Project URL
# Format: https://{your-project-ref}.supabase.co
# Example: https://abcdefghijklmnop.supabase.co
# Location: Project Settings > API > Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous (Public) Key
# This key is safe to use in client-side code (browser, mobile app)
# It respects Row Level Security (RLS) policies
# Location: Project Settings > API > Project API keys > anon/public
# Note: This is a long JWT token (200+ characters)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key
# ⚠️  CRITICAL: This key bypasses Row Level Security - NEVER expose to clients
# Use ONLY in secure server-side code (backend APIs, serverless functions)
# Location: Project Settings > API > Project API keys > service_role
# Note: This is a long JWT token (200+ characters)
# Warning: Anyone with this key has full database access
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Optional - for direct PostgreSQL access)
# ----------------------------------------------------------------------------
# Use these if you need direct database connections (e.g., migrations, pg_dump)
# Location: Project Settings > Database > Connection string
# ----------------------------------------------------------------------------

# Database Connection String
# Format: postgresql://postgres:[password]@db.{project-ref}.supabase.co:5432/postgres
# SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Database Password (if using direct connections)
# Location: Project Settings > Database > Database password
# SUPABASE_DB_PASSWORD=your-database-password

# ----------------------------------------------------------------------------
# STORAGE CONFIGURATION
# ----------------------------------------------------------------------------
# Configuration for the bid-documents storage bucket
# These are informational - actual limits enforced in application code
# ----------------------------------------------------------------------------

# Maximum file size for PDF uploads (in bytes)
# Default: 52428800 (50MB)
MAX_FILE_SIZE_BYTES=52428800

# Allowed MIME types for uploads (comma-separated)
# Default: application/pdf
ALLOWED_MIME_TYPES=application/pdf

# Storage bucket name for bid documents
# Default: bid-documents (as configured in supabase/storage.sql)
STORAGE_BUCKET_NAME=bid-documents

# ----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------------------------------------------

# Application Environment
# Values: development, staging, production
NODE_ENV=development

# Application Port (if running a backend server)
PORT=3000

# Frontend URL (for CORS configuration)
# FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# AI/ML CONFIGURATION (Future Use)
# ----------------------------------------------------------------------------
# Add these when integrating AI services for document analysis
# ----------------------------------------------------------------------------

# OpenAI API Key (for GPT-4 analysis)
# OPENAI_API_KEY=sk-your-openai-api-key

# AI Model to use for analysis
# AI_MODEL=gpt-4-turbo-preview

# OCR Service Configuration
# OCR_SERVICE=tesseract
# OCR_API_KEY=your-ocr-api-key

# ----------------------------------------------------------------------------
# OPTIONAL SERVICES
# ----------------------------------------------------------------------------

# Logging and Monitoring
# SENTRY_DSN=your-sentry-dsn
# LOG_LEVEL=info

# Email Notifications (for deadline reminders, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password

# ----------------------------------------------------------------------------
# DEVELOPMENT TOOLS
# ----------------------------------------------------------------------------

# Enable debug logging
# DEBUG=true

# Supabase Local Development
# Use these when running Supabase locally with `supabase start`
# SUPABASE_URL=http://localhost:54321
# SUPABASE_ANON_KEY=your-local-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Get your Supabase credentials:
#    a. Go to https://app.supabase.com
#    b. Select your project
#    c. Navigate to Project Settings > API
#    d. Copy the Project URL and API keys
#
# 3. Update .env with your values:
#    - Replace "your-project" with your actual Supabase project reference
#    - Replace "your-anon-key-here" with your actual anon key
#    - Replace "your-service-role-key-here" with your actual service role key
#
# 4. Secure your .env file:
#    - Ensure .env is in .gitignore (already configured)
#    - Never commit .env to version control
#    - Use different keys for development/staging/production
#    - Rotate service role key if compromised
#
# 5. Verify configuration:
#    Test connection with a simple query or use the Supabase client library
#
# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================
#
# ✅ DO:
# - Use different Supabase projects for dev/staging/prod
# - Rotate service role key periodically
# - Use environment-specific .env files
# - Store production secrets in secure vault (AWS Secrets Manager, etc.)
# - Enable RLS policies on all tables
# - Use anon key for client-side operations
# - Use service role key only in secure backend
#
# ❌ DON'T:
# - Commit .env to git
# - Share service role key with anyone
# - Use service role key in client-side code
# - Use production keys in development
# - Expose keys in error messages or logs
# - Store keys in frontend code or public repositories
#
# ============================================================================
